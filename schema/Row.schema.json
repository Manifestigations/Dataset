{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "w": {
      "type": "number"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "act": {
      "type": "number"
    },
    "partial": {
      "type": "boolean"
    },
    "p": {
      "$ref": "#/definitions/Band"
    },
    "a": {
      "$ref": "#/definitions/Band"
    },
    "f": {
      "$ref": "#/definitions/Band"
    },
    "i": {
      "$ref": "#/definitions/Band"
    },
    "flag": {
      "$ref": "#/definitions/Partial%3CRecord%3CMetric%2CFlag%3E%3E"
    },
    "noteRef": {
      "$ref": "#/definitions/Partial%3CRecord%3CMetric%2CNoteRef%3E%3E"
    }
  },
  "required": [
    "w",
    "from",
    "to"
  ],
  "additionalProperties": false,
  "description": "One week of one episode. `w` is the row index and must run sequentially from 0; `from`/`to` are ISO dates that bracket it. A missing metric means \"no published figure\" — never zero.",
  "definitions": {
    "Band": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      ],
      "description": "A single published figure, or a published range [low, high].\n\nStorage never collapses a range: no midpoint, and never an average of two publishers. `low` is the figure its source stands behind, `high` the widest count any source supports, and both travel to the renderer so a caption can print the range a chart can only hint at.\n\n`midOf()` below does collapse, for plotting. The rule is about storage: anything that quotes a number rather than drawing one must read the band."
    },
    "Partial<Record<Metric,Flag>>": {
      "type": "object",
      "properties": {
        "p": {
          "$ref": "#/definitions/Flag"
        },
        "a": {
          "$ref": "#/definitions/Flag"
        },
        "f": {
          "$ref": "#/definitions/Flag"
        },
        "i": {
          "$ref": "#/definitions/Flag"
        }
      },
      "additionalProperties": false
    },
    "Flag": {
      "type": "string",
      "enum": [
        "n",
        "r",
        "p",
        "f",
        "e",
        "c",
        "w",
        "x"
      ],
      "description": "n = published point · r = regional only · p = partial · f = floor e = derived/modelled · c = stock or actions-total · w = weekly aggregate \"x\" = a wider measure than the metric's definition (perturbés, closed)."
    },
    "Partial<Record<Metric,NoteRef>>": {
      "type": "object",
      "properties": {
        "p": {
          "$ref": "#/definitions/NoteRef"
        },
        "a": {
          "$ref": "#/definitions/NoteRef"
        },
        "f": {
          "$ref": "#/definitions/NoteRef"
        },
        "i": {
          "$ref": "#/definitions/NoteRef"
        }
      },
      "additionalProperties": false
    },
    "NoteRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "k": {
              "type": "string",
              "const": "obs"
            },
            "date": {
              "type": "string"
            },
            "metric": {
              "$ref": "#/definitions/MetricKey"
            }
          },
          "required": [
            "k",
            "date",
            "metric"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "k": {
              "type": "string",
              "const": "policing"
            },
            "low": {
              "type": "number"
            },
            "high": {
              "type": "number"
            },
            "date": {
              "type": "string"
            }
          },
          "required": [
            "k",
            "low",
            "high",
            "date"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "k": {
              "type": "string",
              "const": "heli"
            },
            "hoursLow": {
              "type": "number"
            },
            "hoursHigh": {
              "type": "number"
            },
            "date": {
              "type": "string"
            }
          },
          "required": [
            "k",
            "hoursLow",
            "hoursHigh",
            "date"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "k": {
              "type": "string",
              "const": "cumulative"
            },
            "days": {
              "type": "number"
            },
            "added": {
              "type": "boolean"
            }
          },
          "required": [
            "k",
            "days",
            "added"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "k": {
              "type": "string",
              "const": "week"
            },
            "p": {
              "$ref": "#/definitions/WeekNoteParts"
            }
          },
          "required": [
            "k",
            "p"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A note is a reference to copy, never the copy itself."
    },
    "MetricKey": {
      "type": "string",
      "enum": [
        "turnout",
        "strikers",
        "arrests",
        "forcesInjured",
        "forcesInjuredStock",
        "protesterInjured",
        "damagesCost",
        "policingCost",
        "heliCost",
        "blockades"
      ]
    },
    "WeekNoteParts": {
      "type": "object",
      "properties": {
        "days": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "enum": [
            "national",
            "regional"
          ]
        },
        "peak": {
          "type": "string"
        },
        "noNational": {
          "type": "boolean"
        },
        "excluded": {
          "type": "number"
        },
        "floored": {
          "type": "boolean"
        },
        "clipped": {
          "type": "boolean"
        },
        "vacation": {
          "type": "boolean",
          "description": "The week overlaps the Toussaint holiday — the metric did not exist."
        }
      },
      "required": [
        "days",
        "kind"
      ],
      "additionalProperties": false,
      "description": "Structured weekly-aggregate note — rendered per locale by notes.ts."
    }
  }
}
